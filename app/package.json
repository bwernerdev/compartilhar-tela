{
  "name": "tela-compartilhada",
  "productName": "Tela Compartilhada",
  "version": "1.1.0",
  "description": "Apresenta a tela na página Tela Compartilhada sem a barra de aviso do Chrome",
  "author": "bwernerdev",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "icone": "electron build/gerar-icone.js"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.bwernerdev.telacompartilhada",
    "productName": "Tela Compartilhada",
    "files": [
      "main.js",
      "preload-seletor.js",
      "seletor.html",
      "erro.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Tela Compartilhada.exe"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum"
  }
}
